# El sistema opera 100% local y sin conexión a internet, así que por ahora
# no hay claves de API ni credenciales que guardar aquí. Este archivo queda
# como plantilla para configuración local futura (ej. rutas de desarrollo
# alternativas). Cuando se use, cada quien crea su propio archivo ".env"
# (que .gitignore ya excluye) copiando este.

APP_ENV=development
